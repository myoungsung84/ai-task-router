# Node task server config — copy to .env if you want to override defaults.

PORT=9914

# Where task metadata + logs are stored (JSON files). Defaults to apps/server/data.
# DATA_DIR=D:\01.src\home\ai-task-router\apps\server\data

# CLI binaries — override if not on PATH.
# CLAUDE_BIN=claude
# CODEX_BIN=codex

# Passed as `claude -p ... --permission-mode <this>`.
# acceptEdits: auto-accepts file edits, still gates other tool use.
# CLAUDE_PERMISSION_MODE=acceptEdits

# Optional Codex model override.
# CODEX_MODEL=

# CORS origin allowed to call this server (the Next.js dev server).
WEB_ORIGIN=http://localhost:9913
