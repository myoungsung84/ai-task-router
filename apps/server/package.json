{
  "name": "@ai-task-router/server",
  "version": "0.1.0",
  "private": true,
  "description": "Node task server: git handling, Claude/Codex CLI process management, SSE log streaming.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0"
  },
  "dependencies": {
    "@ai-task-router/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.5",
    "cross-spawn": "^7.0.3",
    "dotenv": "^17.4.2",
    "express": "^4.21.1",
    "node-notifier": "^10.0.1",
    "uuid": "^9.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/node-notifier": "^8.0.5",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
